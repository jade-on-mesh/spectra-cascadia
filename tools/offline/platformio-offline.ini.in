; Generated by tools/offline/setup.sh — registry-free build of the release envs.
[platformio]
extra_configs = platformio.ini

[offline]
platform = file://@DEPS@/platform-ststm32
platform_packages =
    framework-arduinoststm32 @ symlink://@DEPS@/core
    framework-cmsis @ symlink://@DEPS@/cmsis
    framework-cmsis-dsp @ symlink://@DEPS@/cmsisdsp
    toolchain-gccarmnoneeabi @ symlink://@DEPS@/toolchain
lib_deps =
lib_extra_dirs = @DEPS@/libs
lib_ldf_mode = deep+
upload_protocol = stlink

[env:us]
extends = env:specter, offline

[env:xl]
extends = env:specter_xl, offline

[env:eu]
extends = env:specter_eu, offline

[env:xl_eu]
extends = env:specter_xl_eu, offline
